{
  "request": {
    "method": "POST",
    "url": "/pcs/Balance",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer mocked-bt-token"
      }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$.prisonerId" }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "bt-pinphone-balance-response.json"
  }
}